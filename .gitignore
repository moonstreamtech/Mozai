# Node / build outputs
node_modules/
dist/
.cache/
.parcel-cache/
*.tsbuildinfo

# IDE / editor metadata
.idea/
*.iml
.vscode/
.DS_Store
.history/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env files — ad ids must come from CI secrets, never the repo
.env
.env.local
.env.*.local

# Note: public/content/index.json and public/content/room*/thumbs.json
# ARE tracked. They're produced by scripts/build-content-index.mjs and
# consumed at three different layers:
#   (a) Vite, which copies them into dist/ at build.
#   (b) The CDN sync, which mirrors them from git → moonstreamtech
#       .github.io/mozai-content/ so the maker tool can discover
#       existing puzzles.
#   (c) The content-index-on-pr workflow, which regenerates them
#       on every content PR and commits any drift back.
# Keeping them tracked is what makes the three layers consistent.

# Capacitor / Android build outputs.
# The android/ folder itself is generated by `npx cap add android` and is
# committed (Capacitor convention so native code lives in source control),
# but its build outputs are not.
android/.gradle/
android/.idea/
android/app/build/
android/app/release/
android/build/
android/capacitor-cordova-android-plugins/
android/local.properties
android/*.iml
android/app/*.iml

# Keystores: never commit. Release keystore is materialised at CI build time
# from a base64 secret (MOZAI_KEYSTORE_BASE64 → android/app/mozai-release.keystore)
# mirroring Last Tile's flow.
*.keystore
*.jks
android/app/mozai-release.keystore
release.keystore

# iOS — not in scope for v1 but exclude generated build artefacts pre-emptively
ios/App/build/
ios/App/Pods/
ios/App/App.xcworkspace/xcuserdata/
ios/DerivedData/
